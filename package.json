{
  "name": "pdfsuite",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @pdfsuite/web dev",
    "bench": "pnpm --filter @pdfsuite/bench bench",
    "format": "prettier --write .",
    "dev:desktop": "concurrently -k -n web,app \"pnpm dev:web\" \"pnpm --filter @pdfsuite/desktop dev\"",
    "start:desktop": "pnpm build && pnpm --filter @pdfsuite/desktop start",
    "dev:services": "pnpm --filter @pdfsuite/api dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
